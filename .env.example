# Copy this file to ".env" and fill in your real values.
# The .env file is git-ignored and never committed.

# --- Naukri credentials ---
NAUKRI_EMAIL=your-email@example.com
NAUKRI_PASSWORD=your-password

# --- Path to the CV/resume to upload (relative to project root or absolute) ---
# Place your resume in the cv/ folder and point to it here.
CV_PATH=cv/resume.pdf

# --- Runtime options ---
# Run the browser without a visible window (true for scheduled runs, false to watch it).
HEADLESS=true

# Where the saved login session lives (created by `npm run login`).
STORAGE_STATE=auth/storageState.json
